<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Forsa.Mobile.ViewModels"
             xmlns:controls="clr-namespace:Forsa.Mobile.Controls"
             x:Class="Forsa.Mobile.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             SafeAreaEdges="None"
             BackgroundColor="#F5F7F9">

    <Grid>

        <!-- Tab content stays mounted when switching tabs. -->
        <ContentView IsVisible="{Binding IsDiscover}">
            <Label Text="Discover" HorizontalOptions="Center" VerticalOptions="Center" />
        </ContentView>
        <ContentView IsVisible="{Binding IsActivity}">
            <Label Text="Activity" HorizontalOptions="Center" VerticalOptions="Center" />
        </ContentView>
        <ContentView IsVisible="{Binding IsResumeAi}">
            <Label Text="Resume AI" HorizontalOptions="Center" VerticalOptions="Center" />
        </ContentView>
        <ContentView IsVisible="{Binding IsProfile}">
            <Label Text="Profile" HorizontalOptions="Center" VerticalOptions="Center" />
        </ContentView>

        <!-- Fully drawn bar. Respects the home indicator / gesture bar. -->
        <Grid VerticalOptions="End" SafeAreaEdges="Container" BackgroundColor="Transparent">
            <controls:GlassTabBarCanvas Items="{Binding Tabs}"
                                        BackgroundColor="Transparent"
                                        SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" />
        </Grid>

    </Grid>
</ContentPage>
